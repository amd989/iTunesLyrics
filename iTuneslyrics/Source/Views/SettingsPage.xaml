<Page
    x:Class="iTuneslyrics.Source.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock
                Text="Settings"
                FontSize="22"
                FontWeight="Medium" />
            <ui:InfoBar
                IsOpen="{Binding IsTokenMissing}"
                Severity="Warning"
                Title="Genius API token required"
                Message="Create a client at genius.com/api-clients, then paste its Client Access Token below."
                IsClosable="False"
                Margin="0,16,0,0" />
            <ui:InfoBar
                IsOpen="{Binding IsSaved}"
                Severity="Success"
                Title="Token saved"
                Message="You can go back to Home and fetch lyrics."
                IsClosable="False"
                Margin="0,16,0,0" />
        </StackPanel>

        <!-- API Token -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock
                Text="Genius API Token"
                FontSize="13"
                FontWeight="Medium"
                Margin="0,0,0,8" />
            <ui:PasswordBox
                Password="{Binding ApiToken, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,0,0,6" />
            <TextBlock
                FontSize="11"
                Opacity="0.35">
                <Run Text="Stored at:" />
                <Run Text="{Binding ConfigFilePath, Mode=OneWay}" />
            </TextBlock>
            <ui:Button
                Content="Save Token"
                Appearance="Primary"
                Command="{Binding SaveCommand}"
                Margin="0,12,0,0" />
        </StackPanel>

        <!-- Always on top -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock
                Text="Window"
                FontSize="13"
                FontWeight="Medium"
                Margin="0,0,0,8" />
            <ui:ToggleSwitch
                Content="Always on top"
                IsChecked="{Binding IsAlwaysOnTop}" />
        </StackPanel>
    </Grid>
</Page>
