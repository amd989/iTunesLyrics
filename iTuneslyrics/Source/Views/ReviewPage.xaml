<Page
    x:Class="iTuneslyrics.Source.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">
    <!-- False opts out of WPF-UI's page-level DynamicScrollViewer (see ResultsPage.xaml);
         the lyrics TextBox scrolls on its own. -->

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Track header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="64"
                Height="64"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,16,0">
                <Image
                    Source="{Binding AlbumArt}"
                    Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding TrackCounter}"
                    FontSize="11"
                    Opacity="0.35"
                    Margin="0,0,0,3" />
                <TextBlock
                    Text="{Binding Song}"
                    FontSize="17"
                    FontWeight="Medium" />
                <TextBlock
                    Text="{Binding Artist}"
                    FontSize="13"
                    Opacity="0.5"
                    Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Lyrics -->
        <TextBox
            Grid.Row="1"
            Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            FontFamily="Georgia"
            FontSize="13"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="12"
            Margin="0,0,0,20" />

        <!-- Loading indicator -->
        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            VerticalAlignment="Top"
            Height="2" />

        <!-- Actions -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <ui:Button
                Content="Cancel All"
                Appearance="Danger"
                Command="{Binding CancelAllCommand}"
                Margin="0,0,8,0" />
            <ui:Button
                Content="Skip"
                Appearance="Secondary"
                Command="{Binding SkipCommand}"
                Margin="0,0,8,0" />
            <ui:Button
                Content="Update"
                Appearance="Primary"
                Command="{Binding UpdateCommand}"
                IsEnabled="{Binding CanUpdate}" />
        </StackPanel>
    </Grid>
</Page>
