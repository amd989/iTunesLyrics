<ui:FluentWindow
    x:Class="iTuneslyrics.Source.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:iTuneslyrics.Source.Views"
    Title="iTunes Lyrics"
    Width="720"
    Height="520"
    MinWidth="580"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:NavigationView
            x:Name="NavigationView"
            Grid.ColumnSpan="2"
            IsPaneToggleVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="160">

            <ui:NavigationView.Header>
                <ui:TitleBar Title="iTunes Lyrics" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Home"
                    TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem
                    Content="Results"
                    TargetPageType="{x:Type views:ResultsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
